{% import '_includes/forms.twig' as forms %}

{{ forms.textareaField({
    label: 'System Prompt'|t('craft-loki'),
    instructions: 'Sent to the AI as the system role. Supports Twig variables like {siteLang} and {entryTitle}.'|t('craft-loki', {
        siteLang: '`{{ siteLang }}`',
        entryTitle: '`{{ entryTitle }}`',
    }),
    id: 'basePrompt',
    name: 'basePrompt',
    rows: 8,
    value: settings.basePrompt,
}) }}

{% for provider in [
    {name: 'OpenAI', handle: 'openaiApiKey', envVar: '$OPENAI_API_KEY'},
    {name: 'Claude', handle: 'claudeApiKey', envVar: '$CLAUDE_API_KEY'},
    {name: 'DeepL', handle: 'deeplApiKey', envVar: '$DEEPL_API_KEY'},
] %}
    {{ forms.autosuggestField({
        label: '{provider} API Key'|t('craft-loki', {provider: provider.name}),
        instructions: 'Either paste your {provider} key directly, or reference an environment variable like {envVar}.'|t('craft-loki', {
            provider: provider.name,
            envVar: provider.envVar,
        }),
        id: provider.handle,
        name: provider.handle,
        value: attribute(settings, provider.handle),
        suggestEnvVars: true,
    }) }}
{% endfor %}
